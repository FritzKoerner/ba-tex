  booktitle = {2022 {{IEEE}}/{{RSJ International Conference}} on {{Intelligent Robots}} and {{Systems}} ({{IROS}})},
  author = {Bartolomei, Luca and Kompis, Yves and Teixeira, Lucas and Chli, Margarita},
