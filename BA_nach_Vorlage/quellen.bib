@article{rodriguezUseDronesDelivery2026,
  title = {Use of Drones for the Delivery of Medical Supplies: A Scoping Review of Case Studies},
  shorttitle = {Use of Drones for the Delivery of Medical Supplies},
  author = {Rodríguez, Sebastián and León-Prieto, Catalina and Rodríguez-Jaime, María Fernanda},
  date = {2026-05-02},
  journaltitle = {Case Studies on Transport Policy},
  shortjournal = {Case Studies on Transport Policy},
  pages = {101833},
  issn = {2213-624X},
  doi = {10.1016/j.cstp.2026.101833},
  url = {https://www.sciencedirect.com/science/article/pii/S2213624X2600129X},
  urldate = {2026-05-03},
  abstract = {Objective Synthesize existing evidence on drones for the distribution of medical supplies. Methodology Scoping review conducted according to Joanna Briggs Institute guidelines and reported in accordance with the PRISMA extension for scoping reviews. A systematic search was conducted in PubMed, Scopus, Web of Science, Bireme, EBSCO, and TRID through January 20, 2025, to identify case studies worldwide that use drones to distribute medical supplies. Record selection, performed in Rayyan, included a two-stage review of titles and abstracts and full texts, carried out by two reviewers in a blinded and independent manner. Data extraction followed the same approach, and results were synthesized descriptively. Results A total of 452 records were identified; 21 case studies (2018–2025) were finally selected, with experiences on five continents. Drones reduced the average transport time to 45\,min (range 10–120) compared to 305\,min with conventional methods (60\,min–5\,days), equivalent to an absolute average reduction of 260\,min (4.3\,h) and a relative average reduction of 72\% (35–95\% depending on context); In extreme cases, Malawi and Vanuatu, journeys of several days were reduced to {$<$}2\,h. Of 16 records with costs, the median was \$16.07 (2025 USD), the mean was \$93.29 (range 1.16–613.41), with a strongly biased distribution; most were ≤\$20, while a few reflected aggregate costs/CapEx. Conclusion Drones substantially reduce delivery times (median 45\,min vs. 305\,min) and show mainly low unit costs (median \$16.07), but high heterogeneity and the presence of capital costs require standardizing reports and evaluating cost-effectiveness according to scale.},
  keywords = {Drug delivery systems,Equipment and supplies,Health services accessibility,Unmanned aerial vehicles},
  file = {/home/fritz-sfl/Zotero/storage/QLGQFJ3W/Rodríguez et al. - 2026 - Use of drones for the delivery of medical supplies a scoping review of case studies.pdf;/home/fritz-sfl/Zotero/storage/JAGUHL47/S2213624X2600129X.html}
}

@article{silvagniMultipurposeUAVSearch2017,
  title = {Multipurpose {{UAV}} for Search and Rescue Operations in Mountain Avalanche Events},
  author = {Silvagni, Mario and Tonoli, Andrea and Zenerino, Enrico and Chiaberge, Marcello},
  date = {2017-01-01},
  journaltitle = {Geomatics, Natural Hazards and Risk},
  volume = {8},
  number = {1},
  pages = {18--33},
  publisher = {Taylor \& Francis},
  issn = {1947-5705},
  doi = {10.1080/19475705.2016.1238852},
  url = {https://doi.org/10.1080/19475705.2016.1238852},
  urldate = {2026-05-03},
  abstract = {This paper presents a multipurpose UAV (unmanned aerial vehicle) for mountain rescue operations. The multi-rotors based flying platform and its embedded avionics are designed to meet environmental requirements for mountainous terrain such as low temperatures, high altitude and strong winds, assuring the capability of carrying different payloads (separately or together) such as: avalanche beacon (ARTVA) with automatic signal recognition and path following algorithms for the rapid location of snow-covered body; camera (visible and thermal) for search and rescue of missing persons on snow and in woods during the day or night; payload deployment to drop emergency kits or specific explosive cartridge for controlled avalanche detachment. The resulting small (less than 5 kg) UAV is capable of full autonomous flight (including take-off and landing) of a pre-programmed, or easily configurable, custom mission. Furthermore, the autopilot manages the sensors measurements (i.e. beacons or cameras) to update the flying mission automatically in flight. Specific functionalities such as terrain following were developed and implemented. Ground station programming of the UAV is not needed, except compulsory monitoring, as the rescue mission can be accomplished in a full automatic mode.},
  keywords = {Avalanche,beacon,search and rescue,UAV},
  file = {/home/fritz-sfl/Zotero/storage/Z7267LVE/Silvagni et al. - 2017 - Multipurpose UAV for search and rescue operations in mountain avalanche events.pdf}
