  url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/iet-rsn.2017.0251},
  urldate = {2026-05-03},
  abstract = {Visual condition inspections serve as the basis for determining the need and schedule for service tasks such as maintenance and remediation projects to preserve the proper functioning of power facilities and infrastructure. An increasing accumulation of service projects has recently surfaced due to the lengthy, labour-intensive and subjective qualities of the current method for inspection. These processes are also costly due to the temporary closure of the infrastructure as well as the requirement of special inspection equipment. Unmanned aerial vehicles (UAVs), commonly known as drones, offer potential as a useful tool for infrastructure inspections. UAVs provide visual assessments of structures while eliminating the need for manual inspections. Thus, aerial systems have the potential to reduce the cost of inspections as well as limit the disruption of the public while allowing engineers to have a better three-dimensional understanding of the system. However, the implementation of UAV inspection includes several difficulties such as flight stability, control accuracy, and safety. This study summarises the context for UAV inspection of power facilities and structures. Technologies to address the hindrances preventing UAV integration into the current practice are reviewed. Existing challenges and future work in research for UAV inspections are also presented.},
  langid = {english},
  keywords = {autonomous aerial vehicles,drones,inspection,power facilities,power structures,state-of-the-art technologies,UAV inspections,unmanned aerial vehicles},
  file = {/home/fritz-sfl/Zotero/storage/LJ7TBCFH/Jordan et al. - 2018 - State-of-the-art technologies for UAV inspections.pdf;/home/fritz-sfl/Zotero/storage/2M9IY4EB/iet-rsn.2017.html}
}

@article{mashoriRemoteSensingUAVs2026,
  title = {Remote {{Sensing}} through {{UAVs}} for Precision Agriculture: {{Applications}}, Technical Foundations, Current Barriers, and Future Opportunities},
  shorttitle = {Remote {{Sensing}} through {{UAVs}} for Precision Agriculture},
  author = {Mashori, Abdul Sattar and Li, Fuzhong and Aman, Muhammad and Zhang, Wuping and Jia, Shujie and Ali, Aamir and Jabeen, Nida and Hao, Wangli and Yan, Yuqiao},
  date = {2026-08-01},
  journaltitle = {Smart Agricultural Technology},
  shortjournal = {Smart Agricultural Technology},
  volume = {14},
  pages = {102074},
  issn = {2772-3755},
  doi = {10.1016/j.atech.2026.102074},
  url = {https://www.sciencedirect.com/science/article/pii/S2772375526002959},
  urldate = {2026-05-03},
  abstract = {The integration of Unmanned Aerial Vehicles (UAVs) into agricultural practices represents a significant transition from conventional farming methods toward precision-oriented, data-driven systems that align with the broader objectives of precision agriculture. This review systematically examines the evolving applications of UAVs within agricultural domains, emphasizing their growing role in enhancing operational efficiency and supporting sustainable farming practices. Equipped with advanced Remote Sensing (RS) technologies including multispectral and hyperspectral sensors, thermal imaging systems, Light Detection and Ranging (LiDAR), and Global Positioning Systems (GPS), UAVs enable real-time, high-resolution environmental monitoring. In addition, they play a critical role in high-throughput phenotyping, livestock surveillance, and site-specific irrigation management, collectively supporting the development of climate-resilient and sustainable agricultural ecosystems. The integration of Artificial Intelligence (AI) and Machine Learning (ML) algorithms into UAV data pre-processing and post-processing workflows further enhances their functionality by enabling advanced predictive modeling and analytics. However, despite these advantages, the widespread adoption of UAVs is constrained by several challenges, including limited flight endurance due to power constraints, high operational and maintenance costs, regulatory and airspace restrictions, and the inherent complexity associated with managing and processing large volumes of UAV-acquired data. Further technical limitations, including restricted payload capacity and vulnerability to unfavorable weather conditions, also constrain UAV performance. Nevertheless, recent advancements such as hybrid UAV platforms, multi-sensor integration, autonomous swarm-based operations, and energy-efficient design architectures are steadily mitigating these challenges. By consolidating recent technological developments, application use cases, and prevailing limitations, this study provides a comprehensive reference for researchers, agronomists, and policymakers seeking to effectively harness UAV technologies for future agricultural innovation.},
  keywords = {Data processing,Phenotyping,Precision agriculture,Remote Sensing,Sensing technology,UAVs applications,Unmanned aerial vehicles},
  file = {/home/fritz-sfl/Zotero/storage/DJFEVX2S/Mashori et al. - 2026 - Remote Sensing through UAVs for precision agriculture Applications, technical foundations, current.pdf;/home/fritz-sfl/Zotero/storage/ZAAUSH64/S2772375526002959.html}
}

@article{radoglou-grammatikisCompilationUAVApplications2020,
  title = {A Compilation of {{UAV}} Applications for Precision Agriculture},
  author = {Radoglou-Grammatikis, Panagiotis and Sarigiannidis, Panagiotis and Lagkas, Thomas and Moscholios, Ioannis},
  date = {2020-05-08},
  journaltitle = {Computer Networks},
  shortjournal = {Computer Networks},
  volume = {172},
  pages = {107148},
  issn = {1389-1286},
  doi = {10.1016/j.comnet.2020.107148},
  url = {https://www.sciencedirect.com/science/article/pii/S138912862030116X},
  urldate = {2026-05-03},
  abstract = {Climate change has introduced significant challenges that can affect multiple sectors, including the agricultural one. In particular, according to the Food and Agriculture Organization of the United Nations (FAO) and the International Telecommunication Union (ITU), the world population has to find new solutions to increase the food production by 70\% by 2050. The answer to this crucial challenge is the suitable adoption and utilisation of the Information and Communications Technology (ICT) services, offering capabilities that can increase the productivity of the agrochemical products, such as pesticides and fertilisers and at the same time, they should minimise the functional cost. More detailed, the advent of the Internet of Things (IoT) and specifically, the rapid evolution of the Unmanned Aerial Vehicles (UAVs) and Wireless Sensor Networks (WSNs) can lead to valuable and at the same time economic Precision Agriculture (PA) applications, such as aerial crop monitoring and smart spraying tasks. In this paper, we provide a survey regarding the potential use of UAVs in PA, focusing on 20 relevant applications. More specifically, first, we provide a detailed overview of PA, by describing its various aspects and technologies, such as soil mapping and production mapping as well as the role of the Global Positioning Systems (GPS) and Geographical Information Systems (GIS). Then, we discriminate and analyse the various types of UAVs based on their technical characteristics and payload. Finally, we investigate in detail 20 UAV applications that are devoted to either aerial crop monitoring processes or spraying tasks. For each application, we examine the methodology adopted, the proposed UAV architecture, the UAV type, as well as the UAV technical characteristics and payload.},
  keywords = {Precision agriculture (PA),Remote sensing (RS),Unmanned aerial vehicle (UAV)},
  file = {/home/fritz-sfl/Zotero/storage/DHBJQ82K/Radoglou-Grammatikis et al. - 2020 - A compilation of UAV applications for precision agriculture.pdf;/home/fritz-sfl/Zotero/storage/L2886T5L/S138912862030116X.html}
}

@article{undeExpandingRoleMultirotor2025,
  title = {The Expanding Role of Multirotor {{UAVs}} in Precision Agriculture with Applications {{AI}} Integration and Future Prospects},
  author = {Unde, Sanket S. and Kurkute, V. K. and Chavan, Sachin S. and Mohite, Dadaso D. and Harale, Akshay A. and Chougle, Ayaan},
